{
  "title": "PiggyMetrics - Resilience4j Circuit Breakers",
  "uid": "piggymetrics-resilience4j",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(resilience4j_circuitbreaker_state, application)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Circuit breaker state",
      "description": "1 = the circuit breaker is currently in that state.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (application, name, state) (resilience4j_circuitbreaker_state{application=~\"$application\"} == 1)",
          "legendFormat": "{{application}} / {{name}} / {{state}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Failure rate (%)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "resilience4j_circuitbreaker_failure_rate{application=~\"$application\"}",
          "legendFormat": "{{application}} / {{name}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Calls per second by outcome",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application, name, kind) (rate(resilience4j_circuitbreaker_calls_seconds_count{application=~\"$application\"}[1m]))",
          "legendFormat": "{{application}} / {{name}} / {{kind}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Call latency (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, application, name) (rate(resilience4j_circuitbreaker_calls_seconds_bucket{application=~\"$application\"}[5m])))",
          "legendFormat": "{{application}} / {{name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Not permitted calls per second (circuit open)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application, name) (rate(resilience4j_circuitbreaker_not_permitted_calls_total{application=~\"$application\"}[1m]))",
          "legendFormat": "{{application}} / {{name}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Buffered calls in the sliding window",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "resilience4j_circuitbreaker_buffered_calls{application=~\"$application\"}",
          "legendFormat": "{{application}} / {{name}} / {{kind}}"
        }
      ]
    }
  ]
}
